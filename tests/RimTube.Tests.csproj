<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="GameSmoke/**" />
    <Compile Remove="UiContext/**" />
    <Compile Remove="PreviewGame/**" />
    <Compile Include="../src/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../src/Sources/*.cs" Link="Sources/%(Filename)%(Extension)" />
    <Compile Include="../src/Jobs.cs" Link="Jobs.cs" />
  </ItemGroup>
</Project>
